rules_version = '2';

// กฎความปลอดภัยของฐานข้อมูล: ทุกคนอ่านผลงานได้ แต่แก้ไขได้เฉพาะบัญชีผู้ดูแล
// ถ้าเปลี่ยน ADMIN_EMAIL ใน js/config.js ให้แก้อีเมลบรรทัดด้านล่างให้ตรงกันด้วย
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jittipat_admin@nextgen-jittipat.web';
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /works/{workId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // สถิติผู้เข้าชม: ผู้เข้าชมแต่ละคนเขียนได้เฉพาะเอกสารของตัวเอง ผู้ดูแลเท่านั้นที่อ่านได้
    match /visits/{visitorId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == visitorId
        && request.resource.data.keys().hasOnly(['last', 'visits', 'days', 'pages', 'works']);
    }
  }
}
